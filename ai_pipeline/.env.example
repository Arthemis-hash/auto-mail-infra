# === Gmail — choisir UNE méthode ===
# Méthode A: App Password
#   Active validation 2 étapes → https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Méthode B: OAuth 2.0 (sans mot de passe)
#   https://console.cloud.google.com → Gmail API → OAuth 2.0
# GMAIL_CLIENT_ID=xxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-xxx

# === LinkedIn — Token direct depuis Developer Portal ===
# Va sur https://developer.linkedin.com/ → App → Auth → Create token
# LINKEDIN_TOKEN=your_token_here
# LINKEDIN_PERSON_ID=your_person_id

# === Sécurité — Liste blanche des expéditeurs autorisés ===
# Tout sender utilisé dans une note doit figurer dans cette liste.
# SENDERS_WHITELIST=mail1@domaine.com,mail2@domaine.com

# === Mode ===
DRY_RUN=true
